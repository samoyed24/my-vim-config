" 基础配置
set nocompatible          " 关闭兼容模式
filetype plugin indent on " 启用文件类型检测、插件和缩进
syntax on                 " 启用语法高亮
set number                " 显示行号
set relativenumber        " 相对行号（可选）
set tabstop=4             " 一个 Tab 显示为 4 个空格
set shiftwidth=4          " >> << 缩进使用 4 个空格
set expandtab             " Tab 转为空格
set autoindent            " 自动缩进
set smartindent           " 智能缩进
set nowrap                " 禁止自动换行
set hlsearch              " 高亮搜索
set incsearch             " 增量搜索
set ignorecase            " 搜索忽略大小写
set smartcase             " 搜索含大写则区分大小写
set mouse=a               " 启用鼠标操作
set clipboard=unnamedplus " 共享系统剪贴板
